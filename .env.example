# Environment Variables for SkyCoin Deployment

# Deployment wallet private key (temporary, for deployment only)
PRIVATE_KEY="your_deployment_wallet_private_key_here"

# BSCScan API key for contract verification
BSCSCAN_API_KEY="your_bscscan_api_key_here"

# Token recipient (who gets initial supply)
RECIPIENT_ADDRESS="address_to_receive_initial_tokens"

# LEDGER HARDWARE WALLET ADDRESS (final owner)
LEDGER_ADDRESS="your_ledger_hardware_wallet_address_here"

# Whether to automatically transfer ownership after deployment
TRANSFER_OWNERSHIP="true"

# Optional: Additional RPC endpoints
INFURA_KEY="your_infura_key"
ALCHEMY_KEY="your_alchemy_key"

# Security note: Never commit the actual .env file to version control!
